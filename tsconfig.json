{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // Required by ts-jest once `module` is node16: a hybrid module kind is only supported when
    // each file can be transpiled on its own. It also matches how ts-jest compiles anyway.
    "isolatedModules": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@app/*": ["./src/app/*"],
      "@config": ["./src/config/index.ts"],
      "@jobs/*": ["./src/jobs/*"],
      "@config/*": ["./src/config/*"],
      "@modules/*": ["./src/modules/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  // ts-node compiles only what the entrypoint imports, so an ambient declaration file that
  // nothing imports — `src/shared/types/express.d.ts` — is invisible to it, and `req.id` fails to
  // compile at container start. `files` makes ts-node read the `include` list below, the way `tsc`
  // and ts-jest already do. Without it the API starts locally and dies in Docker.
  "ts-node": { "files": true },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
