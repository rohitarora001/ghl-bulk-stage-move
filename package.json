{
  "name": "ghl-bulk-stage-move",
  "version": "1.0.0",
  "main": "dist/src/api/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "migrate": "ts-node scripts/migrate.ts",
    "seed": "ts-node scripts/seed.ts",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker/index.ts",
    "dev": "concurrently -n api,worker -c blue,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "start:api": "node dist/src/api/index.js",
    "start:worker": "node dist/src/worker/index.js",
    "bench:bulk": "ts-node scripts/benchmark/bulkMove.ts",
    "bench:interactive": "ts-node scripts/benchmark/interactiveLoad.ts",
    "bench:kill": "ts-node scripts/benchmark/killResume.ts",
    "bench:report": "ts-node scripts/benchmark/report.ts",
    "bench:all": "npm run bench:bulk && npm run bench:interactive && npm run bench:kill && npm run bench:report"
  },
  "license": "UNLICENSED",
  "description": "GoHighLevel SDE-3 take-home: resumable, idempotent bulk pipeline-stage move",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
